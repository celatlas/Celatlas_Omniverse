/*
 * Configuration path: /ST110250_A1/06.binSegment/square_bin/ST110250_A1_bin50
 */

params {
    // Basic parameters - updated to server paths
    input_dir = "/ST110250_A1/06.binSegment/square_bin/ST110250_A1_bin50"
    output_dir = "/results/nextflow_results"
    species = "mmu"  // auto, human, mmu - explicitly specified as mouse based on data
    
    // Core analysis modules (enabled by default)
    modules = [
        "qc",           // Quality control - required
        "pca",          // PCA and clustering - required
        "marker",       // Marker gene analysis - required
        "singler"       // SingleR cell type annotation - required
    ]
    
    // Optional analysis module switches
    enable_cellchat = true      // CellChat cell communication analysis
    enable_monocle = true       // Monocle3 trajectory analysis
    enable_enrichment = true    // Functional enrichment analysis
    
    // Report generation switches
    enable_report_generation = true    // Generate comprehensive analysis report
    enable_ui_optimization = true      // Enable UI optimization
    
    // Sample information
    sample_id = "Brain_01"          // Sample ID
    tissue_type = "Brain"               // Tissue type
    resolution = "50 μm"               // Resolution (bin50)
    tissue_image_path = "/mnt/strna/celatlas_spatial/image/ST110250_A1.png"  // Tissue section image path
    
    // Quality control parameters - optimized for spatial transcriptomics
    qc {
        min_features = 100      // Minimum genes per spot (spatial transcriptomics usually lower)
        max_features = 8000     // Maximum genes per spot
        max_mt_percent = 5     // Maximum mitochondrial gene percentage (%)
        min_cells = 5           // Minimum spots per gene
    }
    
    // Spatial plot display parameters
    spatial_plot_pt_size = 0.2  // Point size factor in spatial plots, adjusts spot display size
    
    // PCA and clustering parameters
    clustering {
        n_pcs = 50              // Number of PCA components
        resolution = 0.2        // Clustering resolution (spatial data can be slightly higher)
        k_param = 20            // KNN parameter
        n_neighbors = 30        // UMAP neighbors
        min_dist = 0.3          // UMAP minimum distance
        chose_pcs = 20          // Selected principal components
    }
    
    // PCA visualization parameters
    pca_elbow_plot_dims = 50    // Number of principal components shown in elbow plot, for evaluating optimal PC count
    
    // Marker gene analysis parameters
    marker {
        min_pct = 0.25          // Minimum expression percentage
        logfc_threshold = 0.25  // log2FC threshold
        test_use = "wilcox"     // Statistical test method: wilcox, bimod, roc, t, negbinom, poisson, LR, MAST, DESeq2
        top_n = 5              // Top genes per cluster (spatial data can have more)
    }
    
    // SingleR parameters
    singler {
        reference = "auto"      // auto, HumanPrimaryCellAtlasData, MouseRNAseqData
        fine_tune = true        // Whether to perform fine tuning
        prune_score = 0.5       // Pruning score threshold
    }
    
    // CellChat parameters
    cellchat {
        database = "auto"       // auto, CellChatDB.human, CellChatDB.mouse
        min_cells = 5           // Minimum spots per cell type (spatial data has fewer)
        seed_use = 1            // Random seed to ensure reproducible results
    }
    
    // Monocle3 parameters
    monocle {
        num_dim = 30            // Dimensionality reduction dimensions
        min_cells_per_type = 10 // Minimum spots per cell type (spatial data has fewer)
        reduction_method = "UMAP" // Dimensionality reduction method: UMAP, tSNE, PCA
        max_components = 2       // Maximum number of principal components
    }
    
    // Functional enrichment analysis parameters
    enrichment {
        organism = "auto"       // Auto-detect species
        pval_cutoff = 0.05      // P-value threshold
        logfc_cutoff = 0.5      // log2FC threshold
        min_pct = 0.1           // Minimum expression percentage
    }
    
    // Computational resource configuration - adjusted based on server resources
    max_cpus = 16              // Increase CPU usage
    max_memory = '32.GB'       // Increase memory usage
    max_time = '48.h'          // Increase maximum runtime
    
    // Report generation parameters
    report {
        template = "advanced_spatial_report_template_enhanced.html"  // HTML template file
        output_format = "html"                                       // Output format
        include_interactive = true                                   // Include interactive elements
        compress_images = false                                      // Compress images
        embed_assets = true                                          // Embed resource files
        
        // Report content settings
        sections = [
            "summary",          // Analysis summary
            "qc",              // Quality control
            "clustering",      // Clustering analysis
            "annotation",      // Cell type annotation
            "markers",         // Marker genes
            "communication",   // Cell communication
            "trajectory",      // Developmental trajectory
            "enrichment"       // Functional enrichment
        ]
        
        // UI settings
        theme = "professional"              // Theme: professional, minimal, colorful
        color_scheme = "blue_gradient"      // Color scheme
        layout = "responsive"               // Layout: responsive, fixed
        font_family = "Inter"               // Font family
        
        // Chart settings
        chart_library = "plotly"            // Chart library: plotly, chartjs, d3
        image_format = "png"                // Image format: png, svg, pdf
        image_dpi = 300                     // Image resolution
        
        // Export settings
        enable_pdf_export = true            // Enable PDF export
        enable_data_download = true         // Enable data download
        
        // Configuration file path (optional)
        config_file = "report_config.yaml"  // Optional external configuration file
    }
    
    // Help information
    help = false
}